<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: Helvetica, Arial, sans-serif; font-size: 12pt; color: #1a1a1a; }
      h1 { font-size: 16pt; margin-bottom: 4px; }
      .meta { color: #555; font-size: 10pt; margin-bottom: 20px; }
      table { width: 100%; border-collapse: collapse; margin-top: 12px; }
      td, th { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
      th { background: #f2f2f2; width: 35%; }
      .ack { margin-top: 40px; font-size: 10pt; }
      .sig-line { margin-top: 40px; border-top: 1px solid #333; width: 250px; }
    </style>
  </head>
  <body>
    <h1>Asset Issuance Form</h1>
    <p class="meta">Issued {{ issued_at }} &middot; Ref {{ asset.id }}</p>

    <table>
      <tr><th>Employee</th><td>{{ employee.name }} ({{ employee.emp_id }})</td></tr>
      <tr><th>Department</th><td>{{ employee.dept_id }}</td></tr>
      <tr><th>Asset type</th><td>{{ asset.type }}</td></tr>
      <tr><th>Make / model</th><td>{{ asset.make_model }}</td></tr>
      <tr><th>Serial number</th><td>{{ asset.serial or "-" }}</td></tr>
      <tr><th>Value</th><td>{{ asset.value }}</td></tr>
      {% if ticket_ref %}<tr><th>Ticket reference</th><td>{{ ticket_ref }}</td></tr>{% endif %}
    </table>

    <p class="ack">
      By signing below, {{ employee.name }} acknowledges receipt of the above asset in
      working condition and agrees to the company's asset-use policy.
    </p>
    <div class="sig-line"></div>
    <p>Employee signature &amp; date</p>
  </body>
</html>
