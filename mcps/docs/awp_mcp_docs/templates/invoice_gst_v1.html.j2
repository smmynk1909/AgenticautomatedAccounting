<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: Helvetica, Arial, sans-serif; font-size: 11pt; color: #1a1a1a; }
      h1 { font-size: 16pt; margin-bottom: 2px; }
      .meta { color: #555; font-size: 9pt; margin-bottom: 16px; }
      table { width: 100%; border-collapse: collapse; margin-top: 10px; }
      td, th { border: 1px solid #ccc; padding: 6px 8px; text-align: left; font-size: 10pt; }
      th { background: #f2f2f2; }
      .totals td { font-weight: bold; }
    </style>
  </head>
  <body>
    <h1>Tax Invoice</h1>
    <p class="meta">Invoice {{ number }} &middot; {{ client }} &middot; GST treatment: {{ gst_treatment }}</p>

    <table>
      <tr><th>Description</th><th>Qty</th><th>Unit Price</th></tr>
      {% for line in lines %}
      <tr><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.unit_price }}</td></tr>
      {% endfor %}
      <tr><td colspan="2">Subtotal</td><td>{{ subtotal }}</td></tr>
      {% if cgst != "0" %}<tr><td colspan="2">CGST</td><td>{{ cgst }}</td></tr>
      <tr><td colspan="2">SGST</td><td>{{ sgst }}</td></tr>{% endif %}
      {% if igst != "0" %}<tr><td colspan="2">IGST</td><td>{{ igst }}</td></tr>{% endif %}
      <tr class="totals"><td colspan="2">Total</td><td>{{ total }}</td></tr>
    </table>
  </body>
</html>
