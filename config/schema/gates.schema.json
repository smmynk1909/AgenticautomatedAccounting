{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gates.yaml",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "required": ["approver_roles", "n_required", "ttl_h", "payload_model"],
    "additionalProperties": false,
    "properties": {
      "approver_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "n_required": { "type": "integer", "minimum": 1 },
      "ttl_h": { "type": "integer", "exclusiveMinimum": 0 },
      "payload_model": { "type": ["string", "null"] },
      "notes": { "type": "string" }
    }
  }
}
