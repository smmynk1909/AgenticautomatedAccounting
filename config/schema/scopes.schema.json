{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scopes.yaml",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" }
  },
  "propertyNames": { "pattern": "^[a-z_]+\\.[a-zA-Z_]+$" }
}
