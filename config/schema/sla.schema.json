{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sla.yaml",
  "type": "object",
  "required": ["calendar", "business_hours", "priorities", "escalation_ladder"],
  "properties": {
    "calendar": { "type": "string" },
    "business_hours": {
      "type": "object",
      "required": ["start", "end"],
      "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
    },
    "holidays_ref": { "type": "string" },
    "priorities": {
      "type": "object",
      "required": ["P1", "P2", "P3", "P4"],
      "additionalProperties": {
        "type": "object",
        "required": ["first_response_minutes", "resolution_hours"],
        "properties": {
          "first_response_minutes": { "type": "number", "exclusiveMinimum": 0 },
          "resolution_hours": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "escalation_ladder": { "type": "array", "minItems": 1 },
    "staleness_thresholds_days": { "type": "object" },
    "waiting_requester": {
      "type": "object",
      "required": ["reminder_days", "auto_resolve_days"],
      "properties": {
        "reminder_days": { "type": "number" },
        "auto_resolve_days": { "type": "number" }
      }
    }
  }
}
