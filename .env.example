# Copy to .env and adjust. Never commit the real .env.

# --- Postgres (system of record) ---
# Host port defaults to 5433, not Postgres' usual 5432: several dev boxes in
# this project have a native (non-Docker) PostgreSQL service already bound
# to 5432, which silently wins the port and makes every host-side client
# (alembic, seed script, tests) authenticate against the wrong server
# instead of this Compose stack's container. Change POSTGRES_PORT (and the
# DATABASE_URL port below) back to 5432 if nothing else on your machine uses
# it. Containers always talk to each other over the Docker network as
# `postgres:5432` regardless of this host-side mapping.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=awp
POSTGRES_USER=awp
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgresql+asyncpg://awp:changeme_dev_only@localhost:5433/awp

# --- Redis (task bus + cache + idempotency locks) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (documents/artifacts) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=awp_minio
MINIO_ROOT_PASSWORD=changeme_dev_only
MINIO_BUCKET=awp-artifacts
MINIO_SECURE=false

# --- Qdrant (vectors, see mcp-search / doc 08 §4) ---
QDRANT_URL=http://localhost:6333

# --- Gitea (repo backend for mcp-projects, see doc 08 §8 / doc 10 C12) ---
# GITEA_ADMIN_TOKEN is NOT set here — `scripts/gitea_bootstrap.sh` (run once
# after `make up`) creates the admin user below and appends a real
# GITEA_ADMIN_TOKEN line to your real `.env`; there is no fixed dev value
# for it the way there is for the JWT secrets, since Gitea only reveals a
# token's value once, at creation time.
GITEA_URL=http://localhost:3000
GITEA_ADMIN_USER=awp-admin
GITEA_ADMIN_PASSWORD=dev-only-change-me-32bytes-min
GITEA_ADMIN_EMAIL=admin@awp.local

# --- Model gateway (Ollama, see DEVIATIONS.md #1) ---
MODEL_GATEWAY_URL=http://localhost:11434/v1
MODEL_GEN=qwen2.5:7b-instruct
MODEL_SMALL=qwen2.5:3b-instruct
MODEL_CODE=qwen2.5-coder:7b-instruct
MODEL_EMB=bge-m3

# --- Auth: service/agent tokens stay local HS256 (see DEVIATIONS.md #22 —
# human sessions moved to real Keycloak below; this secret now only signs
# agent-to-MCP service JWTs and dev-mode human tokens from /api/dev/login,
# which coexists with real Keycloak login per DEVIATIONS.md #22) ---
AWP_DEV_JWT_SECRET=dev-only-change-me-32bytes-minimum-secret
# Separate secret: only mcp-approvals' tokens.py signs with this one, so no
# agent-scoped JWT (signed with AWP_DEV_JWT_SECRET) can ever forge an approval.
AWP_APPROVAL_JWT_SECRET=dev-only-change-me-different-32byte-secret
AWP_JWT_ISSUER=awp-dev
AWP_JWT_TTL_S=900

# --- Keycloak (real OIDC for human sessions, Sprint 11 — DEVIATIONS.md #22) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me
# KEYCLOAK_URL and KEYCLOAK_PUBLIC_URL are the same value here (host-side
# tooling: pytest, uv run scripts, and a non-Docker gateway all reach
# Keycloak the same way a browser does). Inside Docker they're genuinely
# different — live-verified, DEVIATIONS.md #22 — and
# `deploy/docker-compose.dev.yml`'s gateway service overrides KEYCLOAK_URL
# to `http://host.docker.internal:8080` (the address the gateway
# *container* needs to actually reach Keycloak) while leaving
# KEYCLOAK_PUBLIC_URL at localhost:8080 (the address a token's `iss` claim
# actually contains, fixed by whatever hostname the *browser* used for the
# Keycloak login page, not by whatever address the backend later used for
# the token exchange). Never conflate the two — that was a real bug.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=awp
KEYCLOAK_CLIENT_ID=awp-gateway
KEYCLOAK_CLIENT_SECRET=dev-only-gateway-secret-change-me
KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Audit ---
AWP_AUDIT_SPOOL_DIR=./.spool/audit

# --- Approvals ---
AWP_APPROVAL_TOKEN_TTL_H=24

# --- Observability (Sprint 11 — DEVIATIONS.md #25) ---
# Host-side tooling (pytest, uv run scripts) leaves this unset, same as
# before Sprint 11 — start_span() no-ops without it. Inside Docker,
# docker-compose.dev.yml sets this per-service to http://otel-collector:4317
# regardless of this value; it's only consulted for a non-containerized run.
OTEL_EXPORTER_OTLP_ENDPOINT=
AWP_LOG_LEVEL=INFO
# Grafana admin login (anonymous Viewer access is also enabled — dev only).
GRAFANA_ADMIN_PASSWORD=dev-only-not-for-prod

# --- Go-live posture (Sprint 12) ---
# HITL-max: forces mcp-finance's expense_posting gate for every posting,
# ignoring the amount/confidence auto-post thresholds — the "day zero,
# nothing auto-approves yet" posture doc 12 §5 names for go-live. See
# mcps/finance/awp_mcp_finance/tools_ledger.py's module docstring.
AWP_HITL_MAX=true

# --- Config directory (see DEVIATIONS.md #7) ---
# Dev: leave unset — awp_shared.config falls back to the repo-relative
# `config/` dir when running from a source checkout (uv run, pytest).
# Containers: always set explicitly (e.g. /app/config) since a pip-installed,
# non-editable package can't find it via file-relative traversal.
# AWP_CONFIG_DIR=/app/config

# --- Environment tag ---
AWP_ENV=dev
