# Copy to .env and adjust. Never commit the real .env.

# --- Postgres (system of record) ---
# Host port defaults to 5433, not Postgres' usual 5432: several dev boxes in
# this project have a native (non-Docker) PostgreSQL service already bound
# to 5432, which silently wins the port and makes every host-side client
# (alembic, seed script, tests) authenticate against the wrong server
# instead of this Compose stack's container. Change POSTGRES_PORT (and the
# DATABASE_URL port below) back to 5432 if nothing else on your machine uses
# it. Containers always talk to each other over the Docker network as
# `postgres:5432` regardless of this host-side mapping.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=awp
POSTGRES_USER=awp
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgresql+asyncpg://awp:changeme_dev_only@localhost:5433/awp

# --- Redis (task bus + cache + idempotency locks) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (documents/artifacts) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=awp_minio
MINIO_ROOT_PASSWORD=changeme_dev_only
MINIO_BUCKET=awp-artifacts
MINIO_SECURE=false

# --- Qdrant (vectors, see mcp-search / doc 08 §4) ---
QDRANT_URL=http://localhost:6333

# --- Gitea (repo backend for mcp-projects, see doc 08 §8 / doc 10 C12) ---
# GITEA_ADMIN_TOKEN is NOT set here — `scripts/gitea_bootstrap.sh` (run once
# after `make up`) creates the admin user below and appends a real
# GITEA_ADMIN_TOKEN line to your real `.env`; there is no fixed dev value
# for it the way there is for the JWT secrets, since Gitea only reveals a
# token's value once, at creation time.
GITEA_URL=http://localhost:3000
GITEA_ADMIN_USER=awp-admin
GITEA_ADMIN_PASSWORD=dev-only-change-me-32bytes-min
GITEA_ADMIN_EMAIL=admin@awp.local

# --- Model gateway (Ollama, see DEVIATIONS.md #1) ---
MODEL_GATEWAY_URL=http://localhost:11434/v1
MODEL_GEN=qwen2.5:7b-instruct
MODEL_SMALL=qwen2.5:3b-instruct
MODEL_CODE=qwen2.5-coder:7b-instruct
MODEL_EMB=bge-m3

# --- Auth (dev mode, see DEVIATIONS.md #2 — swapped for Keycloak at Sprint 11) ---
AWP_DEV_JWT_SECRET=dev-only-change-me-32bytes-minimum-secret
# Separate secret: only mcp-approvals' tokens.py signs with this one, so no
# agent-scoped JWT (signed with AWP_DEV_JWT_SECRET) can ever forge an approval.
AWP_APPROVAL_JWT_SECRET=dev-only-change-me-different-32byte-secret
AWP_JWT_ISSUER=awp-dev
AWP_JWT_TTL_S=900

# --- Audit ---
AWP_AUDIT_SPOOL_DIR=./.spool/audit

# --- Approvals ---
AWP_APPROVAL_TOKEN_TTL_H=24

# --- Observability (no-op until Sprint 11) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
AWP_LOG_LEVEL=INFO

# --- Config directory (see DEVIATIONS.md #7) ---
# Dev: leave unset — awp_shared.config falls back to the repo-relative
# `config/` dir when running from a source checkout (uv run, pytest).
# Containers: always set explicitly (e.g. /app/config) since a pip-installed,
# non-editable package can't find it via file-relative traversal.
# AWP_CONFIG_DIR=/app/config

# --- Environment tag ---
AWP_ENV=dev
